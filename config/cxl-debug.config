# CXL / DAX debug fragment for Linux v7.3 (also applies to v7.3.x)
# Merge on top of the target's distro config (/boot/config-$(uname -r)).

# --- CXL stack (same module layout as distros) ---
CONFIG_CXL_BUS=m
CONFIG_CXL_PCI=m
CONFIG_CXL_ACPI=m
CONFIG_CXL_MEM=m
CONFIG_LIBNVDIMM=m
CONFIG_CXL_PMEM=m
CONFIG_CXL_PORT=m
CONFIG_CXL_REGION=y
CONFIG_CXL_FEATURES=y
# raw mailbox commands through ioctl, for poking the DUT (taints the kernel when used)
CONFIG_CXL_MEM_RAW_COMMANDS=y
# AMD PRM DPA->SPA address translation (CONFIG_CXL_ATL is def_bool on these)
CONFIG_ACPI_PRMT=y
CONFIG_AMD_NB=y

# --- DAX / Soft Reserved path ---
CONFIG_DAX=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_MEMORY_HOTREMOVE=y
CONFIG_ZONE_DEVICE=y
CONFIG_DEV_DAX=m
CONFIG_DEV_DAX_CXL=m
CONFIG_DEV_DAX_HMEM=m
CONFIG_DEV_DAX_KMEM=m
CONFIG_EFI_SOFT_RESERVE=y
CONFIG_FIRMWARE_MEMMAP=y
CONFIG_MEMORY_HOTPLUG=y

# --- printk / dynamic debug ---
CONFIG_DEBUG_KERNEL=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_LOG_BUF_SHIFT=25
CONFIG_DYNAMIC_DEBUG=y
CONFIG_DEBUG_FS=y
# driver core: "probe with driver X rejects match -6", bind/match traces
CONFIG_DEBUG_DRIVER=y
# PCI core dev_dbg (BAR assignment, resource conflicts, capability parsing)
CONFIG_PCI_DEBUG=y
CONFIG_PCIEAER=y
CONFIG_PCIEPORTBUS=y

# --- tracing (function_graph with return values, kprobes, bpftrace) ---
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_FUNCTION_GRAPH_RETVAL=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_EVENTS=y

# --- keep the config inside the kernel ---
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- boot parameters built into the image, so the debug kernel needs no GRUB/grubby edit ---
# x86 puts the built-in line in front of the boot loader's line (arch/x86/kernel/setup.c:917-921);
# /proc/cmdline shows both. What each parameter does: cmdline.txt. panic=30 reboots 30 s after a
# panic, which brings the machine back to the pinned distro kernel (RUNBOOK.md F).
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="log_buf_len=64M initcall_debug efi=debug panic=30"
